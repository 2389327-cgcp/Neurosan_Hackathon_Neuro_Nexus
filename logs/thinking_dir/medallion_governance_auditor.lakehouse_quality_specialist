## PySpark Bronze → Silver Transformation

```python
from pyspark.sql import SparkSession
from pyspark.sql.functions import col, to_timestamp, when, trim, sha2, concat
from pyspark.sql.types import StructType, StructField, StringType, TimestampType

spark = SparkSession.builder.getOrCreate()

# Define schema for memory efficiency
schema = StructType([
    StructField("user_id", StringType(), False),
    StructField("full_name", StringType(), True),
    StructField("email", StringType(), True),
    StructField("ssn", StringType(), True),
    StructField("signup_timestamp", StringType(), True),
    StructField("city", StringType(), True),
    StructField("status", StringType(), True)
])

# Parse raw JSON payload
df_raw = spark.read.json(spark.sparkContext.parallelize([raw_payload]), schema=schema)

# Bronze to Silver transformation
df_silver = (
    df_raw
    # Trim string fields
    .withColumn("user_id", trim(col("user_id")))
    .withColumn("full_name", trim(col("full_name")))
    .withColumn("email", trim(col("email")))
    .withColumn("city", trim(col("city")))
    # Cast timestamp
    .withColumn("signup_timestamp", to_timestamp(col("signup_timestamp"), "yyyy-MM-dd'T'HH:mm:ss'Z'"))
    # Hash PII fields (SSN masked at Silver)
    .withColumn("ssn_hash", sha2(concat(col("ssn"), col("user_id")), 256))
    .drop("ssn")
    # Null handling
    .fillna({
        "full_name": "UNKNOWN",
        "email": "unknown@unknown.com",
        "city": "UNKNOWN",
        "status": "PENDING"
    })
    # Validate status
    .withColumn("status", 
        when(col("status").isin("ACTIVE", "INACTIVE", "SUSPENDED"), col("status"))
        .otherwise("UNKNOWN")
    )
    # Deduplication key
    .withColumn("dedup_key", col("user_id"))
)

# Show result
df_silver.display()
```

